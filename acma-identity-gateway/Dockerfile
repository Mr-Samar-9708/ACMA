FROM openjdk:17-alpine

ARG WORKDIR=/opt/gateway
ARG ARTIFACT_NAME=acma-ig-server.jar
ARG SERVICE_PORT=6060

ENV FINAL_ARTIFACT_NAME=${WORKDIR}/${ARTIFACT_NAME}

RUN mkdir ${WORKDIR}
WORKDIR ${WORKDIR}
COPY target/${ARTIFACT_NAME} ${WORKDIR}

EXPOSE ${SERVICE_PORT}

#ENTRYPOINT [ "java -jar ${FINAL_ARTIFACT_NAME}" ]

CMD [ "sh","-c","java -jar ${FINAL_ARTIFACT_NAME}" ]
